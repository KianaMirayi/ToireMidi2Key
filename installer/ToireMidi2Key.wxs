<?xml version="1.0" encoding="utf-8"?>
<!--
  ToireMidi2Key 安装包定义（WiX v5）

  【安装位置策略：能选路径 + 自动父文件夹包裹】
    · 安装界面上让用户选的是「父目录」（属性 INSTALLPARENT，默认 %LocalAppData%\Programs）
    · 实际落地目录由自定义动作在 CostFinalize 之前算出来：
          INSTALLFOLDER = [INSTALLPARENT]\ToireMidi2Key
      所以用户即使把路径填成 D:\ 或 C:\，文件也只会进到 D:\ToireMidi2Key\ 或 C:\ToireMidi2Key\，
      绝不会把 exe/卸载程序/README/LICENSE 散落到盘根或系统目录
    · 为什么用自定义动作而不是直接让 Directory 表做父子推导：
      MSI 不会因为「父目录属性被覆盖」而重新推导子目录（日志实测：INSTALLROOT 变成
      C:\Users\Admin\Desktop，INSTALLFOLDER 仍是默认值）。而且目录属性在 CostFinalize
      之前读不到用户在界面里选的值，所以选择属性用普通属性（INSTALLPARENT）承载。
      （Type 51「设置属性」是 MSI 内置动作，不需要任何自定义代码）
    · 命令行高级用法：msiexec /i ....msi INSTALLFOLDER="D:\临时文件\ToireMidi2Key"
      显式给了 INSTALLFOLDER 时不覆盖（保持原样）

  【推荐以管理员身份安装】许可协议页里写了提示：
    · 默认装到用户目录，不需要管理员
    · 装到 D:\ 等非系统盘时建议右键「以管理员身份运行」，否则 MSI 可能在
      该盘的回滚目录（X:\Config.Msi）上因权限不足报「错误 5」

  其它：
    · Scope="perUser" 每用户安装，默认不弹 UAC；目录可写，config.json 恒在 exe 同目录
    · 安装目录里带「卸载.exe」（Native AOT，不依赖 .NET 运行时），开始菜单也有卸载入口
    · Codepage=936：界面与字符串含中文，WiX 默认 1252 会打包失败
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">

  <Package Name="ToireMidi2Key"
           Manufacturer="KianaMirayi"
           Version="0.1.0"
           UpgradeCode="7E3A1C9B-5D42-4F8A-9C61-2B7E5A4D8F31"
           Scope="perUser"
           Compressed="yes"
           InstallerVersion="500"
           Codepage="936">

    <SummaryInformation Description="ToireMidi2Key —— 把 MIDI 键盘变成电脑键盘" />

    <MajorUpgrade AllowSameVersionUpgrades="yes"
                  DowngradeErrorMessage="已安装更高版本的 ToireMidi2Key，请先卸载后再装这一版。" />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <!-- 安装界面：欢迎 → 许可协议 → 选择安装位置（父目录）→ 确认 → 安装 -->
    <ui:WixUI Id="WixUI_InstallDir" InstallDirectory="INSTALLPARENT" />
    <WixVariable Id="WixUILicenseRtf" Value="installer\license.rtf" />

    <!-- ① 用户选择的父目录（默认 %LocalAppData%\Programs，仅在没有值时兜底） -->
    <CustomAction Id="SetDefaultParent"
                  Property="INSTALLPARENT"
                  Value="[LocalAppDataFolder]Programs\"
                  Execute="immediate"
                  Return="check" />
    <!-- ② 实际落地目录 = 父目录 + \ToireMidi2Key（保证始终有同名父文件夹包裹） -->
    <CustomAction Id="SetInstallFolder"
                  Property="INSTALLFOLDER"
                  Value="[INSTALLPARENT]\ToireMidi2Key"
                  Execute="immediate"
                  Return="check" />

    <InstallUISequence>
      <Custom Action="SetDefaultParent" Before="SetInstallFolder" Condition="NOT INSTALLPARENT" />
      <Custom Action="SetInstallFolder" Before="ExecuteAction" />
    </InstallUISequence>
    <InstallExecuteSequence>
      <Custom Action="SetDefaultParent" Before="SetInstallFolder" Condition="NOT INSTALLPARENT" />
      <Custom Action="SetInstallFolder" Before="CostFinalize" Condition="NOT INSTALLFOLDER" />
    </InstallExecuteSequence>

    <!-- 每用户安装：ALLUSERS=2 + MSIINSTALLPERUSER=1（默认不弹 UAC） -->
    <Property Id="ALLUSERS" Value="2" />
    <Property Id="MSIINSTALLPERUSER" Value="1" />

    <Icon Id="AppIcon" SourceFile="src\ToireMidi2Key.App\Assets\app.ico" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon" />
    <Property Id="ARPHELPLINK" Value="https://github.com/KianaMirayi/ToireMidi2Key" />
    <Property Id="ARPCOMMENTS" Value="弹哪个音，就等于按下哪个电脑按键（MIDI 键盘 → 电脑键盘）" />
    <Property Id="ARPNOREPAIR" Value="1" />

    <!-- 目录结构：LocalAppDataFolder(%LocalAppData%)
                       └ INSTALLPARENT(Programs)        ← 安装界面里选/改这一层（父目录）
                           └ INSTALLFOLDER(ToireMidi2Key)  ← 实际落地目录，所有文件都在这 -->
    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="INSTALLPARENT" Name="Programs">
        <Directory Id="INSTALLFOLDER" Name="ToireMidi2Key">
          <Component Id="AppExe" Guid="*">
            <File Id="AppExeFile" Source="build\app\ToireMidi2Key.exe" KeyPath="yes" />
          </Component>
          <Component Id="UninstallerExe" Guid="*">
            <File Id="UninstallerFile" Source="build\uninstaller\uninstall.exe" Name="卸载.exe" KeyPath="yes" />
          </Component>
          <Component Id="ReadmeFile" Guid="*">
            <File Id="ReadmeMd" Source="README.md" KeyPath="yes" />
          </Component>
          <Component Id="LicenseFile" Guid="*">
            <File Id="LicenseTxt" Source="LICENSE" Name="LICENSE.txt" KeyPath="yes" />
          </Component>
        </Directory>
      </Directory>
    </StandardDirectory>

    <!-- 开始菜单；桌面用标准虚拟符号 DesktopFolder（WiX 5 里不能再声明该目录）-->
    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="AppMenuFolder" Name="ToireMidi2Key" />
    </StandardDirectory>

    <Feature Id="Main" Title="ToireMidi2Key" Level="1" AllowAbsent="no">
      <ComponentRef Id="AppExe" />
      <ComponentRef Id="UninstallerExe" />
      <ComponentRef Id="ReadmeFile" />
      <ComponentRef Id="LicenseFile" />
      <ComponentRef Id="StartMenuShortcut" />
      <ComponentRef Id="UninstallShortcut" />
      <ComponentRef Id="DesktopShortcut" />
    </Feature>

    <Component Id="StartMenuShortcut" Directory="AppMenuFolder" Guid="*">
      <Shortcut Id="StartMenuShortcut" Name="ToireMidi2Key"
                Description="把 MIDI 键盘变成电脑键盘"
                Target="[INSTALLFOLDER]ToireMidi2Key.exe"
                WorkingDirectory="INSTALLFOLDER" />
      <RemoveFolder Id="RemoveAppMenuFolder" On="uninstall" />
      <RegistryValue Root="HKCU" Key="Software\KianaMirayi\ToireMidi2Key"
                     Name="StartMenuShortcut" Type="integer" Value="1" KeyPath="yes" />
    </Component>

    <Component Id="UninstallShortcut" Directory="AppMenuFolder" Guid="*">
      <Shortcut Id="UninstallShortcut" Name="卸载 ToireMidi2Key"
                Description="卸载 ToireMidi2Key"
                Target="[INSTALLFOLDER]卸载.exe"
                WorkingDirectory="INSTALLFOLDER" />
      <RegistryValue Root="HKCU" Key="Software\KianaMirayi\ToireMidi2Key"
                     Name="UninstallShortcut" Type="integer" Value="1" KeyPath="yes" />
    </Component>

    <Component Id="DesktopShortcut" Directory="DesktopFolder" Guid="*">
      <Shortcut Id="DesktopShortcut" Name="ToireMidi2Key"
                Description="把 MIDI 键盘变成电脑键盘"
                Target="[INSTALLFOLDER]ToireMidi2Key.exe"
                WorkingDirectory="INSTALLFOLDER" />
      <RegistryValue Root="HKCU" Key="Software\KianaMirayi\ToireMidi2Key"
                     Name="DesktopShortcut" Type="integer" Value="1" KeyPath="yes" />
    </Component>

  </Package>
</Wix>
